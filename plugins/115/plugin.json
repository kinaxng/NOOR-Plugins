{
  "id": "115",
  "name": "115",
  "version": "0.13.5",
  "type": "downloader",
  "description": "115 Open Platform 离线下载、稳定 STRM 与媒体情报流水线。",
  "tags": ["115", "cloud", "downloader", "strm", "mediainfo"],
  "capabilities": ["downloader", "network_outbound", "download_submit", "sidebar_page", "stream_resolver"],
  "enabled_by_default": false,
  "config_schema": {
    "client_id": {"type": "string", "label": "115 Open Platform Client ID", "description": "在 115 开放平台注册应用后获得。"},
    "access_token": {"type": "password", "label": "Access Token", "secret": true, "hidden": true, "description": "由授权流程自动保存；不会返回前端。"},
    "refresh_token": {"type": "password", "label": "Refresh Token", "secret": true, "hidden": true, "description": "由授权流程自动保存并轮换；不会返回前端。"},
    "offline_directory_id": {"type": "string", "label": "默认离线目录 ID", "default": "0", "hidden": true},
    "offline_directory_name": {"type": "string", "label": "默认离线目录名称", "default": "根目录", "hidden": true},
    "task_discovery_mode": {"type": "select", "label": "任务发现模式", "default": "noor_only", "options": [{"label": "仅 NOOR 任务", "value": "noor_only"}, {"label": "监控绑定目录", "value": "watch_folder"}]},
    "strm_directory": {"type": "string", "label": "STRM incoming 目录", "placeholder": "/data/strm/av/incoming"},
    "organizer_incoming_path": {"type": "string", "label": "MDC-NG 容器内 incoming 路径", "description": "兼容旧配置；现在从 MDC-NG 监控目录自动发现。", "default": "/data/strm/av/incoming", "hidden": true},
    "organizer_sync_enabled": {"type": "boolean", "label": "自动跟踪 MDC-NG 整理结果", "description": "整理完成后保存分类路径并通知 Emby 定向刷新。", "default": true},
    "public_base_url": {"type": "string", "label": "NOOR 外部访问地址", "placeholder": "https://noor.example"},
    "stream_delivery_mode": {"type": "select", "label": "播放交付模式", "description": "兼容代理会保留 Range，避免 Emby 在 302 后因请求头变化被 115 拒绝；确认客户端兼容后可改为 302 直连。", "default": "proxy", "options": [{"label": "兼容代理（推荐）", "value": "proxy"}, {"label": "302 直连", "value": "redirect"}]},
    "stream_url_cache_seconds": {"type": "number", "label": "播放地址短缓存（秒）", "default": 180, "min": 30, "max": 300, "hidden": true},
    "discovery_max_depth": {"type": "number", "label": "任务目录发现深度", "description": "只遍历已完成离线任务返回的目录。", "default": 4, "min": 0, "max": 8, "hidden": true},
    "discovery_max_items": {"type": "number", "label": "单任务发现条目上限", "default": 2000, "min": 20, "max": 10000, "hidden": true},
    "media_extensions": {"type": "string", "label": "媒体扩展名", "default": "mkv,mp4,avi,mov,ts,m2ts,wmv,flv,webm", "hidden": true},
    "subtitle_extensions": {"type": "string", "label": "字幕扩展名", "default": "srt,ass,ssa,sub,vtt", "hidden": true},
    "subtitle_max_bytes": {"type": "number", "label": "单个字幕大小上限（字节）", "default": 20971520, "min": 1048576, "max": 104857600, "hidden": true},
    "mediainfo_enabled": {"type": "boolean", "label": "生成后提取 MediaInfo", "default": true},
    "mediainfo_concurrency": {"type": "number", "label": "MediaInfo 并发", "description": "默认 1；提高并发可能增加网盘风控风险。", "default": 1, "min": 1, "max": 4, "hidden": true},
    "mediainfo_timeout": {"type": "number", "label": "MediaInfo 超时（秒）", "default": 300, "min": 30, "max": 1800, "hidden": true},
    "mediainfo_retry_limit": {"type": "number", "label": "MediaInfo 重试上限", "description": "使用指数退避，不会连续重试。", "default": 3, "min": 1, "max": 5, "hidden": true},
    "strm_assistant_enabled": {"type": "boolean", "label": "神医助手加速", "description": "为新增 STRM 写入社区版神医助手可恢复的 MediaInfo JSON，并在写入后通知 Emby。", "default": true},
    "api_min_interval": {"type": "number", "label": "API 最小请求间隔（秒）", "default": 1, "min": 0.2, "max": 10, "step": 0.2, "hidden": true},
    "offline_poll_interval": {"type": "number", "label": "离线任务检查间隔（秒）", "default": 60, "min": 30, "max": 600, "hidden": true},
    "offline_poll_max_pages": {"type": "number", "label": "任务列表最大检查页数", "description": "仅查询官方离线任务列表，不扫描网盘文件。", "default": 5, "min": 1, "max": 20, "hidden": true},
    "timeout": {"type": "number", "label": "API 超时（秒）", "default": 20, "min": 5, "max": 60, "hidden": true}
  },
  "default_config": {
    "client_id": "",
    "access_token": "",
    "refresh_token": "",
    "offline_directory_id": "0",
    "offline_directory_name": "根目录",
    "task_discovery_mode": "noor_only",
    "strm_directory": "",
    "organizer_incoming_path": "/data/strm/av/incoming",
    "organizer_sync_enabled": true,
    "public_base_url": "",
    "stream_delivery_mode": "proxy",
    "stream_url_cache_seconds": 180,
    "discovery_max_depth": 4,
    "discovery_max_items": 2000,
    "media_extensions": "mkv,mp4,avi,mov,ts,m2ts,wmv,flv,webm",
    "subtitle_extensions": "srt,ass,ssa,sub,vtt",
    "subtitle_max_bytes": 20971520,
    "mediainfo_enabled": true,
    "mediainfo_concurrency": 1,
    "mediainfo_timeout": 300,
    "mediainfo_retry_limit": 3,
    "strm_assistant_enabled": true,
    "api_min_interval": 1,
    "offline_poll_interval": 60,
    "offline_poll_max_pages": 5,
    "timeout": 20
  },
  "contributions": {
    "sidebar": {"label": "115", "route": "/plugins/115", "icon": "icons/sidebar.svg"},
    "downloader_capabilities": {
      "accepts_public_magnet": true,
      "accepts_private_tracker": false,
      "accepts_http_torrent": true,
      "accepts_http_url": true,
      "accepts_ed2k": true
    },
    "icon": "icons/sidebar.svg"
  },
  "frontend": {"type": "module", "entry": "frontend/page.js", "style": "frontend/style.css"},
  "ui_sdk_strict": true
}
