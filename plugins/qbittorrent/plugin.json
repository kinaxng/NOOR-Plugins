{
  "id": "qbittorrent",
  "name": "qBittorrent",
  "version": "0.3.1",
  "type": "downloader",
  "description": "qBittorrent 下载器接入，兼容密码 Cookie 与 5.2+ API Key。",
  "tags": ["qb", "downloader"],
  "capabilities": ["downloader", "network_outbound", "download_submit", "sidebar_page"],
  "enabled_by_default": false,
  "default_config": {
    "base_url": "http://127.0.0.1:8080",
    "username": "",
    "password": "",
    "api_key": "",
    "category": "",
    "savepath": "",
    "noor_tag": "noor",
    "show_noor_only": false,
    "min_file_size_mb": 0
  },
  "config_schema": {
    "base_url": {"type": "string", "label": "qBittorrent 地址"},
    "username": {"type": "string", "label": "用户名"},
    "password": {"type": "password", "label": "密码"},
    "api_key": {"type": "password", "label": "API Key", "description": "qBittorrent 5.2+ 可使用，填写后优先采用 Bearer 认证"},
    "category": {"type": "string", "label": "默认分类"},
    "savepath": {"type": "string", "label": "默认保存路径"},
    "noor_tag": {"type": "string", "label": "NOOR 标签"},
    "show_noor_only": {"type": "boolean", "label": "仅显示 NOOR 任务"},
    "min_file_size_mb": {"type": "number", "label": "最小保留文件大小 MB", "min": 0, "max": 4096}
  },
  "contributions": {
    "sidebar": {"label": "qBittorrent", "route": "/plugins/qbittorrent", "icon": "icons/sidebar.svg"},
    "icon": "icons/sidebar.svg"
  },
  "frontend": {
    "type": "module",
    "entry": "frontend/page.js",
    "style": "frontend/style.css"
  }
}
